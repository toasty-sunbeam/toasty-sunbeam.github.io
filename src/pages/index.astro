---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import '../styles/home.css';

import type { MarkdownInstance } from 'astro';
import type { Frontmatter } from '../frontmatter';
import PostCard from '../components/PostCard.astro';

// Blog posts
const posts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('./posts/*.mdx', { eager: true }))
	.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
---

<MainLayout pageTitle="James Harris" bodyClass="sheet-body">
	<Fragment slot="head">
		<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
		<!-- The figure draws itself on the first visit of the hour. Decided
		     before first paint so a repeat visit never flashes. -->
		<script is:inline data-astro-rerun>
			(function () {
				try {
					var key = 'introPlayedAt';
					var now = Date.now();
					var last = Number(sessionStorage.getItem(key)) || 0;
					var skip = now - last < 60 * 60 * 1000;
					document.documentElement.classList.toggle('intro-skip', skip);
					if (!skip) sessionStorage.setItem(key, String(now));
				} catch (e) {}
			})();
		</script>
	</Fragment>

	<!-- Right-angle squares, nested two and three deep, for the corners -->
	<svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
		<symbol id="ra-2" viewBox="0 0 24 24">
			<polyline points="0,8.5 8.5,8.5 8.5,0" />
			<polyline points="0,16.5 16.5,16.5 16.5,0" />
		</symbol>
		<symbol id="ra-3" viewBox="0 0 24 24">
			<polyline points="0,6.5 6.5,6.5 6.5,0" />
			<polyline points="0,12.5 12.5,12.5 12.5,0" />
			<polyline points="0,18.5 18.5,18.5 18.5,0" />
		</symbol>
	</svg>

	<main class="sheet">
		<div class="frame">
			<svg class="ra ra--tl" aria-hidden="true"><use href="#ra-3" /></svg>
			<svg class="ra ra--tr" aria-hidden="true"><use href="#ra-3" /></svg>
			<svg class="ra ra--br" aria-hidden="true"><use href="#ra-3" /></svg>
			<svg class="ra ra--bl" aria-hidden="true"><use href="#ra-3" /></svg>

			<header class="masthead">
				<h1>James Harris</h1>
			</header>

			<div class="figure">
				<div class="rule rule--ab" aria-hidden="true">
					<span class="pt pt--a mark"></span><span class="lbl lbl--a mark">A</span>
					<span class="pt pt--b mark"></span><span class="lbl lbl--b mark">B</span>
				</div>

				<div class="cols">
					<aside class="col-side">
						<a href="/periodic" class="plate" style="--delay: .6s">
							<figure>
								<img src="/img/ptos-preview.png" alt="Periodic Table of Storytelling" />
								<figcaption>Periodic Table of Storytelling</figcaption>
							</figure>
						</a>

						<section class="panel" style="--delay: .72s">
							<svg class="ra ra--tl" aria-hidden="true"><use href="#ra-2" /></svg>
							<svg class="ra ra--br" aria-hidden="true"><use href="#ra-2" /></svg>
							<h2>Guides</h2>
							<ul class="list">
								<li><a href="/posts/Hardened-backups" class="underline-hover">Cheap, effortless backups</a></li>
								<li><a href="/posts/Hardened-file-syncing" class="underline-hover">File syncing</a></li>
								<li><a href="/posts/Hardened-password-vault" class="underline-hover">Password vault</a></li>
								<li><a href="/posts/Blocking-cookie-notices" class="underline-hover">Blocking cookie banners</a></li>
							</ul>
						</section>

						<section class="panel" style="--delay: .84s">
							<svg class="ra ra--tl" aria-hidden="true"><use href="#ra-2" /></svg>
							<svg class="ra ra--br" aria-hidden="true"><use href="#ra-2" /></svg>
							<h2>Tools</h2>
							<ul class="list">
								<li><a href="https://batch-vision.deno.dev/" class="underline-hover">Batch Vision</a></li>
								<li><a href="https://lancer-name-generator.netlify.app/" class="underline-hover">Name generator</a></li>
								<li><a href="https://marketplace.visualstudio.com/items?itemName=DawnPaladin.twilight-sparkle" class="underline-hover">VSCode theme</a></li>
							</ul>
						</section>

						<section class="panel" style="--delay: .96s">
							<svg class="ra ra--tl" aria-hidden="true"><use href="#ra-2" /></svg>
							<svg class="ra ra--br" aria-hidden="true"><use href="#ra-2" /></svg>
							<h2>Blogroll</h2>
							<ul class="list">
								<li><a href="https://simonwillison.net/" class="underline-hover">
									<img src="https://simonwillison.net/favicon.ico" alt=""/>
									Simon Willison
								</a></li>
								<li><a href="https://ncase.me/" class="underline-hover">
									<img src="https://ncase.me/favicon.png" alt=""/>
									Nicky Case</a></li>
								<li><a href="https://www.astralcodexten.com/" class="underline-hover">
									<img src="https://www.astralcodexten.com/favicon.ico" alt=""/>
									Scott Alexander
								</a></li>
							</ul>
						</section>
					</aside>

					<section class="col-posts">
						<span class="pt pt--c mark" aria-hidden="true"></span><span class="lbl lbl--c mark" aria-hidden="true">C</span>
						<span class="sq sq--c mark" aria-hidden="true"></span>
						<span class="pt pt--d mark" aria-hidden="true"></span><span class="lbl lbl--d mark" aria-hidden="true">D</span>
						<span class="sq sq--d mark" aria-hidden="true"></span>

						<h2 class="col-label" style="--delay: .6s">Posts</h2>
						<ul class="cards">
							{ posts.map((post, index) => (
								<li style={`--delay: ${(0.68 + index * 0.06).toFixed(2)}s`}>
									<PostCard post={post}/>
								</li>
							))}
						</ul>
					</section>
				</div>

				<div class="rule rule--ef" aria-hidden="true">
					<span class="pt pt--e mark"></span><span class="lbl lbl--e mark">E</span>
					<span class="pt pt--f mark"></span><span class="lbl lbl--f mark">F</span>
				</div>
			</div>

			<footer class="colophon">
				<span class="zig" aria-hidden="true"></span>
			</footer>
		</div>
	</main>
</MainLayout>
