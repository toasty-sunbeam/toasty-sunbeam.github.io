---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import '../styles/deco.css';
import '../styles/home-deco.css';

import type { MarkdownInstance } from 'astro';
import type { Frontmatter } from '../frontmatter';
import PostCard from '../components/PostCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

// Blog posts
const posts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('./posts/*.mdx', { eager: true }))
	.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
---

<MainLayout pageTitle="James Harris" bodyClass="deco-body">
	<div class="deco-home mx-auto w-fit px-4">
		<div class="deco-sunbeam" aria-hidden="true">
			<canvas></canvas>
		</div>
		<div class="deco-frame">
			<span class="deco-ra deco-ra--tl" aria-hidden="true"></span>
			<span class="deco-ra deco-ra--tr" aria-hidden="true"></span>
			<span class="deco-ra deco-ra--bl" aria-hidden="true"></span>
			<span class="deco-ra deco-ra--br" aria-hidden="true"></span>
			<div class="deco-toolbar">
				<ThemeToggle />
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-[minmax(200px,300px)_auto] gap-x-5 gap-y-4 max-w-3xl">
				<h1 class="deco-masthead">James Harris</h1>
				<h2 class="deco-section-label hidden sm:flex">Blog posts</h2>
				<hr class="deco-rule hidden sm:block sm:col-span-2" />
				<div class="flex flex-col min-w-0 perspective-container">
					<a href="/periodic" class="deco-plate mb-4 animate-flutter left">
						<img src="/img/ptos-preview.png" alt="Periodic Table of Storytelling" />
					</a>
					<section class="deco-panel deco-panel--jade mb-4 animate-flutter left" style="animation-delay: .15s">
						<h2 class="deco-panel__title">Guides</h2>
						<ul class="deco-list">
							<li><a href="/posts/Hardened-backups" class="underline-hover">💾 Cheap, effortless backups</a></li>
							<li><a href="/posts/Hardened-file-syncing" class="underline-hover">🔁 File syncing</a></li>
							<li><a href="/posts/Hardened-password-vault" class="underline-hover">🔐 Password vault</a></li>
							<li><a href="/posts/Blocking-cookie-notices" class="underline-hover">🍪 Blocking cookie banners</a></li>
						</ul>
					</section>
					<section class="deco-panel deco-panel--lapis mb-4 animate-flutter left" style="animation-delay: .30s">
						<h2 class="deco-panel__title">Tools</h2>
						<ul class="deco-list">
							<li><a href="https://batch-vision.deno.dev/" class="underline-hover">🖼️ Batch Vision</a></li>
							<li><a href="https://lancer-name-generator.netlify.app/" class="underline-hover">👥 Name generator</a></li>
							<li><a href="https://marketplace.visualstudio.com/items?itemName=DawnPaladin.twilight-sparkle" class="underline-hover">🎨 VSCode Theme</a></li>
						</ul>
					</section>
					<section class="deco-panel deco-panel--amethyst mb-4 animate-flutter left" style="animation-delay: .45s">
						<h2 class="deco-panel__title">Blogroll</h2>
						<ul class="deco-list">
							<li><a href="https://simonwillison.net/" class="underline-hover">
								<img src="https://simonwillison.net/favicon.ico" alt=""/>
								Simon Willison
							</a></li>
							<li><a href="https://ncase.me/" class="underline-hover">
								<img src="https://ncase.me/favicon.png" alt=""/>
								Nicky Case</a></li>
							<li><a href="https://www.astralcodexten.com/" class="underline-hover">
								<img src="https://www.astralcodexten.com/favicon.ico" alt=""/>
								Scott Alexander
							</a></li>
						</ul>
					</section>
				</div>
				<section class="flex flex-col min-w-64">
					<h2 class="deco-section-label flex mb-4 sm:hidden">Blog posts</h2>
					<ul class="perspective-container">
						{ posts.map((post, index) => (
							<li class="animate-flutter right hover-card" style={`animation-delay: ${index * 0.15}s`}>
								<a href={post.url}>
									<PostCard post={post}/>
								</a>
							</li>
						))}
					</ul>
				</section>
			</div>
		</div>
	</div>
</MainLayout>

<style>
    .perspective-container {
        perspective: 1000px;
    }

    .animate-flutter {
        animation-name: flutter;
        animation-duration: 1.2s;
        animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
        animation-iteration-count: 1;
        transform-style: preserve-3d;
        will-change: transform;
    }
	.animate-flutter.left {
        transform-origin: right center;
		--dir: 1;
	}
	.animate-flutter.right {
        transform-origin: left center;
		--dir: -1;
	}

	@media (prefers-reduced-motion: reduce) {
		.animate-flutter {
			animation: none;
			transform: none;
		}
	}

    @keyframes flutter {
        /* The "Dampened Spring" Effect:
           It gets pushed out, snaps back, wobbles slightly, then rests.
        */
        0% {
            transform: rotateY(0deg);
        }
        25% {
            /* The Gust: Pushes the card out */
            /* 8deg * -1 becomes -8deg (Butterfly effect) */
            transform: rotateY(calc(8deg * var(--dir, 1)));
        }
        50% {
            /* The Snap Back: Tension pulls it back, slightly overshooting neutral */
			transform: rotateY(calc(-3deg * var(--dir, 1)));
		}
        75% {
            /* The Residual Wobble: Little bit of energy left */
			transform: rotateY(calc(3deg * var(--dir, 1)));
		}
        100% {
            /* Settle */
            transform: rotateY(0deg);
        }
    }
</style>

<script>
	import '../scripts/sunbeam.ts';

	const ONE_HOUR = 60 * 60 * 1000;

	function handleFlutterAnimation() {
		const lastPlayed = sessionStorage.getItem('flutterPlayedAt');
		const now = Date.now();

		if (lastPlayed && now - parseInt(lastPlayed) < ONE_HOUR) {
			// Animation played recently, skip it
			document.querySelectorAll<HTMLElement>('.animate-flutter').forEach(el => {
				el.style.animation = 'none';
			});
		} else {
			// Let animation play and record the time
			sessionStorage.setItem('flutterPlayedAt', now.toString());
		}
	}

	// Run on initial load and on view transition navigation
	handleFlutterAnimation();
	document.addEventListener('astro:page-load', handleFlutterAnimation);
</script>