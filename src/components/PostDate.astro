---
interface Props {
	date: Date | string;
}

const { date } = Astro.props;
const dateObj = new Date(date);
---
<time datetime={dateObj.toISOString()}>
	{dateObj.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		// Frontmatter dates have no time, so they parse as midnight UTC.
		// Formatting in local time would show the day before in the Americas.
		timeZone: 'UTC'
	})}
</time>
