---
import type { MarkdownInstance } from 'astro';
import type { Frontmatter } from '../frontmatter';
import PostDate from './PostDate.astro';

interface Props {
	post: MarkdownInstance<Frontmatter>;
}

const { post } = Astro.props;

// Each post picks a colour name in its frontmatter. On the sheet that colour
// is used flat, in the manner of Byrne's Euclid, for the card's emblem and
// its hover state.
const palette: Record<string, string> = {
	'red': '#b9382c',
	'orange': '#cf6a1f',
	'amber': '#c98a1b',
	'yellow': '#bfa020',
	'lime': '#7f9a26',
	'green': '#2f7d5a',
	'cyan': '#23848f',
	'blue': '#2d5aa6',
	'indigo': '#3e4d9d',
	'violet': '#6b4fae',
	'purple': '#7e3d8c',
	'fuchsia': '#ac3f7e',
	'pink': '#c05a80',
	'gray': '#6f6a60',
};

const color = palette[post.frontmatter.cardColor] ?? palette.gray;
---
<article class="card" style={`--c: ${color}`}>
	<svg class="emblem" viewBox="0 0 28 28" aria-hidden="true">
		<rect x="0.5" y="0.5" width="27" height="27" />
		<rect class="emblem__mid" x="6.5" y="6.5" width="15" height="15" />
		<rect class="emblem__core" x="11" y="11" width="6" height="6" />
	</svg>
	<div class="card__body">
		<h3 transition:name={`post-title-${post.url}`}>
			<a href={post.url}>{post.frontmatter.title}</a>
		</h3>
		{post.frontmatter.pubDate && (
			<PostDate date={post.frontmatter.pubDate} />
		)}
		{post.frontmatter.excerpt && <p>{post.frontmatter.excerpt}</p>}
	</div>
</article>
