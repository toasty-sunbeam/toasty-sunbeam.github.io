---
interface Props {
    id: string;
    number: number;
    html: string;
}

const { id, number, html } = Astro.props;
---

<div class="sidebar-footnote" data-footnote-id={id}>
    <b>{number}.</b> <Fragment set:html={html} />
</div>

<style>
    .sidebar-footnote {
        font-size: 0.85rem;
        line-height: 1.4;
        color: var(--deco-text-dim);
        margin-bottom: 0.5rem;
        padding: 0.5rem 0.6rem;
        background: color-mix(in oklab, var(--deco-surface) 70%, transparent);
        border: 1px solid var(--deco-accent);
        border-left-width: 2px;
        /* Same left-to-neutral fade as the cards; see home-deco.css. */
        border-image: linear-gradient(to right,
            var(--deco-accent) 0 25%,
            var(--deco-line) 100%) 1;
        width: 100%;
        box-sizing: border-box;
        transition: top 0.2s ease;
        word-break: break-word;
        position: absolute;
    }

    .sidebar-footnote b {
        color: var(--deco-metal-em);
    }

    .sidebar-footnote :global(a) {
        color: var(--deco-text);
    }

    .sidebar-footnote :global(p) {
        margin-bottom: 0;
        display: inline;
    }

    .sidebar-footnote :global(a[href^="#user-content-fnref"]) {
        display: none;
    }
</style>
