---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
const { pageTitle, bodyClass = '' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600&family=Poiret+One&family=Rosario:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
        <ClientRouter/>
		<title>{pageTitle}</title>
		<script is:inline>
			// Runs before the body exists so the stored choice is on <html>
			// before anything paints. No stored choice means no attribute,
			// which leaves the reader's system preference in charge.
			(() => {
				const KEY = 'deco-theme';
				const read = () => {
					try { return localStorage.getItem(KEY); } catch { return null; }
				};
				const apply = () => {
					const stored = read();
					if (stored === 'light' || stored === 'dark') {
						document.documentElement.dataset.theme = stored;
					} else {
						delete document.documentElement.dataset.theme;
					}
				};
				apply();
				// View transitions swap the document; put the attribute back.
				document.addEventListener('astro:after-swap', apply);

				if (window.__decoThemeBound) return;
				window.__decoThemeBound = true;
				document.addEventListener('click', (event) => {
					const button = event.target.closest('[data-theme-toggle]');
					if (!button) return;
					const systemLight = matchMedia('(prefers-color-scheme: light)').matches;
					const current = read() || (systemLight ? 'light' : 'dark');
					const next = current === 'dark' ? 'light' : 'dark';
					try { localStorage.setItem(KEY, next); } catch { /* private mode */ }
					document.documentElement.dataset.theme = next;
				});
			})();
		</script>
	</head>
	<body class:list={['bg-sky-200/65', bodyClass]}>
		<slot/>
	</body>
</html>
